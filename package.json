{
  "name": "golazo-desktop",
  "version": "0.1.0",
  "description": "Golazo desktop project, implementation, and token usage manager",
  "author": "Gianserra",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "assets:icons": "node scripts/generate-icons.mjs",
    "dev:frontend": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "node scripts/run-cargo.mjs build && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 node scripts/run-electron-dev.mjs",
    "dev": "concurrently -k -s first \"pnpm dev:frontend\" \"wait-on http://127.0.0.1:5173 && pnpm dev:electron\"",
    "build:frontend": "vite build",
    "build:backend": "node scripts/run-cargo.mjs build --release && node scripts/stage-rust-backend.mjs",
    "build": "pnpm build:frontend",
    "package:desktop": "node scripts/stage-electron-app.mjs && electron-builder --projectDir release/electron-app",
    "dist": "pnpm build:frontend && pnpm build:backend && pnpm package:desktop",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.gianserra.golazo",
    "productName": "Golazo",
    "icon": "electron/assets/icon.png",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/backend",
        "to": "backend"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "electron/assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "wait-on": "^9.0.10"
  }
}
